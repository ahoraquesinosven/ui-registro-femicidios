#!/usr/bin/env bash
set -euo pipefail

# Run from the repository root (this script lives in bin/).
cd "$(dirname "$0")/.."

ENV_FILE=".env"

# 1. Ensure .env exists. Compose loads it automatically for variable
#    interpolation (e.g. the dev container's user mapping below).
if [[ ! -f "$ENV_FILE" ]]; then
  cat > "$ENV_FILE" <<'EOF'
# ------------------------------------------------------------------------------
# Local environment overrides. Required settings are appended below by
# bin/setup-local-env.
# ------------------------------------------------------------------------------
EOF
  echo "Created $ENV_FILE"
fi

# 2. Pin host UID/GID so the dev container writes files as you, not root.
#    UID/GID are shell-only and never reach compose, so we bake the resolved
#    values into .env where compose can interpolate them.
grep -q '^HOST_UID=' "$ENV_FILE" || echo "HOST_UID=$(id -u)" >> "$ENV_FILE"
grep -q '^HOST_GID=' "$ENV_FILE" || echo "HOST_GID=$(id -g)" >> "$ENV_FILE"

cat <<EOF

================================================================================
Setup complete. Configuration is in place.

Start the app: docker compose up
================================================================================
EOF
